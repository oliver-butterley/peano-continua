module

public import PeanoPartA.SingularH1

/-!
# `H₁` is generated by loops, one per path component

For an arbitrary space `X : Type` (not necessarily path-connected), every element of the first
singular homology group `H₁(X; ℤ)` (`Peano.singularH1`) is a finite sum of classes of loops based
at chosen representatives of pairwise distinct path components
(`Peano.exists_finset_sum_h1Class`):

> `h = Σ_{c ∈ s} [ℓ c]`, `s` a finite set of path components, `ℓ c` a loop at the chosen point
> `componentRep c` of `c`.

This is the input that turns the "several path components" form of Lemma 3.3 of
Brazas–Pavešić (`Peano.fromPath_mem_commutator_of_sum_homologyClass_eq_zero`) into injectivity of
`H₁(A) → H₁(X)` for arbitrary `A` (`PeanoPartA.SingularH1Lemmas`).

## Proof

Tau Ceti proves the degree-one Hurewicz theorem only for path-connected spaces, and its inverse map
is private, so the chain-level argument (Hatcher, Thm 2A.1) is redone here with one base point per
path component.

* **Generators.** Each point `y` is joined to the representative `compRep y` of its path component
  by a chosen path `repPath y`. A singular `1`-simplex `σ` (a path from `y` to `z`) gives the loop
  `loopAt σ = repPath y · σ · (repPath z)⁻¹` at `compRep y = compRep z`; its chain differs from
  `σ` by `repPath z - repPath y` modulo boundaries (`pathChain_loopAt_sub_mem_boundaries₁`).
* **Linear extension.** With `θ` the linear map `σ ↦ [loopAt σ]` on `1`-chains and `π` the linear
  map `v ↦ [repPath v]` on `0`-chains, `θ c - c + π (∂ c)` is a boundary for every `1`-chain `c`.
  For a cycle `c`, the term `π (∂ c)` vanishes, so `c` is homologous to `θ c`, a combination of
  loops: `H₁` is the subgroup generated by loop classes (`mem_closure_range_h1Class`).
* **Normal form.** By induction over the closure, every element is `Σ_{c ∈ s} [ℓ c]`: a loop at
  `y` is conjugated to `componentRep (mk y)` (`h1Class_conj`), sums are merged component by
  component (`h1Class_trans`), and negatives reverse the loops (`h1Class_symm`).
-/

@[expose] public section

open CategoryTheory Simplicial TauCeti TauCeti.HurewiczOne TauCeti.TopCat

noncomputable section

namespace Peano

variable {X : Type} [TopologicalSpace X]

/-! ### Representatives of path components -/

/-- The chosen point `Quotient.out c` of a path component `c`. -/
def componentRep (c : ZerothHomotopy X) : X := Quotient.out (s := pathSetoid X) c

/-- The chosen point of the path component of `y` is joined to `y`. -/
theorem joined_componentRep_mk (y : X) : Joined (componentRep (ZerothHomotopy.mk y)) y :=
  Quotient.mk_out (s := pathSetoid X) y

/-- The path component of the chosen point of `c` is `c`. -/
theorem mk_componentRep (c : ZerothHomotopy X) : ZerothHomotopy.mk (componentRep c) = c :=
  Quotient.out_eq (s := pathSetoid X) c

/-- Chosen points of distinct path components are not joined. -/
theorem not_joined_componentRep {c c' : ZerothHomotopy X} (h : c ≠ c') :
    ¬ Joined (componentRep c) (componentRep c') := fun hj =>
  h (by rw [← mk_componentRep c, ← mk_componentRep c']; exact Quotient.sound hj)

/-- The chosen point of the path component of `y`. -/
private def compRep (y : X) : X := componentRep (ZerothHomotopy.mk y)

/-- The chosen path from `compRep y` to `y`. -/
private def repPath (y : X) : Path (compRep y) y := (joined_componentRep_mk y).somePath

/-- Joined points have the same chosen component representative. -/
private theorem compRep_eq_of_joined {y z : X} (h : Joined y z) : compRep y = compRep z :=
  congrArg componentRep (Quotient.sound h)

/-! ### The loop through a singular `1`-simplex -/

/-- The loop `repPath y · σ · (repPath z)⁻¹` through a singular `1`-simplex `σ` from `y` to `z`,
based at `compRep y`. -/
private def loopAt (s : (TopCat.toSSet.obj (TopCat.of X)) _⦋1⦌) :
    Path (compRep (source₁ s : X)) (compRep (source₁ s : X)) :=
  (repPath (source₁ s : X)).trans ((path₁ s).trans
    ((repPath (target₁ s : X)).symm.cast rfl (compRep_eq_of_joined ⟨path₁ s⟩)))

/-- The chain of the loop through `σ` differs from `σ` by the chains of the chosen paths at its
endpoints, modulo boundaries. -/
private theorem pathChain_loopAt_sub_mem_boundaries₁ (s : (TopCat.toSSet.obj (TopCat.of X)) _⦋1⦌) :
    pathChain ℤ (loopAt s).toContinuousMap - simplexChain s 1 +
      (pathChain ℤ (repPath (target₁ s : X)).toContinuousMap -
        pathChain ℤ (repPath (source₁ s : X)).toContinuousMap) ∈
        boundaries₁ (TopCat.of X) := by
  set c' : Path (target₁ s : X) (compRep (source₁ s : X)) :=
    (repPath (target₁ s : X)).symm.cast rfl (compRep_eq_of_joined ⟨path₁ s⟩)
  have h₁ := pathChain_add_sub_trans_mem_boundaries₁ (X := TopCat.of X)
    (repPath (source₁ s : X)) ((path₁ s).trans c')
  have h₂ := pathChain_add_sub_trans_mem_boundaries₁ (X := TopCat.of X) (path₁ s) c'
  have h₃ := pathChain_add_symm_mem_boundaries₁ (X := TopCat.of X) (repPath (target₁ s : X))
  have hc' : c'.toContinuousMap = (repPath (target₁ s : X)).symm.toContinuousMap := rfl
  have hs : pathChain ℤ (path₁ s).toContinuousMap = simplexChain s 1 := by
    rw [pathChain, simplex₁_path₁]
  have := sub_mem (sub_mem h₃ h₂) h₁
  rw [hs, hc'] at this
  convert this using 1
  rw [loopAt]
  abel

/-- The linear map sending a singular `1`-simplex to the chain of the loop through it. -/
private def loopChains :
    ((singularChains ℤ).obj (TopCat.of X)).X 1 →ₗ[ℤ] ((singularChains ℤ).obj (TopCat.of X)).X 1 :=
  chainsDesc fun s ↦ pathChain ℤ (loopAt s).toContinuousMap

/-- The linear map sending a singular `0`-simplex to the chain of the chosen path to it. -/
private def pathChains :
    ((singularChains ℤ).obj (TopCat.of X)).X 0 →ₗ[ℤ] ((singularChains ℤ).obj (TopCat.of X)).X 1 :=
  chainsDesc fun v ↦ pathChain ℤ (repPath (TopCat.toSSetObj₀Equiv v : X)).toContinuousMap

/-- A 1-chain differs from its loop-chain rewriting (each simplex conjugated to a loop at the
representative of its component) by a boundary plus the image of its boundary (Hatcher 2A.1). -/
private theorem loopChains_sub_mem_boundaries₁ (c : ((singularChains ℤ).obj (TopCat.of X)).X 1) :
    loopChains c - c + pathChains (((singularChains ℤ).obj (TopCat.of X)).d 1 0 c) ∈
      boundaries₁ (TopCat.of X) := by
  let φ : ((singularChains ℤ).obj (TopCat.of X)).X 1 →+
      ((singularChains ℤ).obj (TopCat.of X)).X 1 ⧸ (boundaries₁ (TopCat.of X)).toAddSubgroup :=
    (QuotientAddGroup.mk' _).comp (loopChains - LinearMap.id +
      pathChains ∘ₗ (((singularChains ℤ).obj (TopCat.of X)).d 1 0).hom).toAddMonoidHom
  have : φ = 0 := singularChains_addMonoidHom_ext fun s ↦ by
    simp only [φ, AddMonoidHom.zero_apply, AddMonoidHom.comp_apply, QuotientAddGroup.mk'_apply,
      QuotientAddGroup.eq_zero_iff, Submodule.mem_toAddSubgroup, LinearMap.toAddMonoidHom_coe,
      LinearMap.add_apply, LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply]
    rw [singularChains_d_simplexChain (n := 0), Fin.sum_univ_two, map_add, map_zsmul, map_zsmul,
      pathChains, chainsDesc_simplexChain_one, chainsDesc_simplexChain_one,
      toSSetObj₀Equiv_δ_zero, toSSetObj₀Equiv_δ_one, loopChains, chainsDesc_simplexChain_one]
    convert pathChain_loopAt_sub_mem_boundaries₁ s using 1
    simp only [Fin.val_zero, Fin.val_one, pow_zero, pow_one, one_smul]
    abel
  exact (Submodule.mem_toAddSubgroup _).1 ((QuotientAddGroup.eq_zero_iff _).1
    (DFunLike.congr_fun this c))

/-- The loop-chain rewriting of a 1-chain is a 1-cycle. -/
private theorem loopChains_mem_cycles₁ (c : ((singularChains ℤ).obj (TopCat.of X)).X 1) :
    loopChains c ∈ cycles₁ (TopCat.of X) := by
  have : (((singularChains ℤ).obj (TopCat.of X)).d 1 0).hom ∘ₗ loopChains = 0 :=
    singularChains_linearMap_ext fun s ↦ by
      rw [LinearMap.comp_apply, loopChains, chainsDesc_simplexChain_one, LinearMap.zero_apply]
      exact pathChain_mem_cycles₁ (loopAt s)
  exact mem_cycles₁ (LinearMap.congr_fun this c)

/-! ### Generation by loops -/

/-- **`H₁` is generated by loop classes** (any space): every element of `H₁(X; ℤ)` lies in the
subgroup generated by the classes of loops. -/
theorem mem_closure_range_h1Class (h : singularH1 X) :
    h ∈ AddSubgroup.closure {k | ∃ (y : X) (γ : Path y y), h1Class γ = k} := by
  set L : AddSubgroup (singularH1 X) :=
    AddSubgroup.closure {k | ∃ (y : X) (γ : Path y y), h1Class γ = k}
  let Φ : ((singularChains ℤ).obj (TopCat.of X)).X 1 →+ singularH1 X :=
    (H₁AddEquivHomology (TopCat.of X)).toAddMonoidHom.comp
      (H₁.mk.comp (loopChains.codRestrict (cycles₁ (TopCat.of X))
        loopChains_mem_cycles₁).toAddMonoidHom)
  have hΦ : (QuotientAddGroup.mk' L).comp Φ = 0 := singularChains_addMonoidHom_ext fun s ↦ by
    simp only [AddMonoidHom.comp_apply, AddMonoidHom.zero_apply, QuotientAddGroup.mk'_apply,
      QuotientAddGroup.eq_zero_iff]
    refine AddSubgroup.subset_closure ⟨_, loopAt s, ?_⟩
    simp only [Φ, h1Class, loopClass_def, AddEquiv.toAddMonoidHom_eq_coe,
      AddMonoidHom.coe_comp, AddMonoidHom.coe_ofClass, Function.comp_apply,
      LinearMap.toAddMonoidHom_coe]
    congr 2
    exact Subtype.ext (by
      simp only [LinearMap.codRestrict_apply, loopChains, chainsDesc_simplexChain_one])
  obtain ⟨z, rfl⟩ := (H₁AddEquivHomology (TopCat.of X)).surjective h
  obtain ⟨c, rfl⟩ := H₁.mk_surjective z
  have hc : H₁.mk c = H₁.mk ⟨loopChains (c : ((singularChains ℤ).obj (TopCat.of X)).X 1),
      loopChains_mem_cycles₁ _⟩ := by
    rw [H₁.mk_eq_mk_iff]
    have h0 := loopChains_sub_mem_boundaries₁ (c : ((singularChains ℤ).obj (TopCat.of X)).X 1)
    rw [mem_cycles₁_iff.1 c.2, map_zero, add_zero] at h0
    simpa using neg_mem h0
  rw [hc]
  exact (QuotientAddGroup.eq_zero_iff _).1
    (DFunLike.congr_fun hΦ (c : ((singularChains ℤ).obj (TopCat.of X)).X 1))

/-- **Normal form of `H₁`** (any space): every element of `H₁(X; ℤ)` is a finite sum
`Σ_{c ∈ s} [ℓ c]` of classes of loops `ℓ c` based at the chosen points `componentRep c` of pairwise
distinct path components `c`. -/
theorem exists_finset_sum_h1Class (h : singularH1 X) :
    ∃ (s : Finset (ZerothHomotopy X)) (ℓ : ∀ c, Path (componentRep c) (componentRep c)),
      h = ∑ c ∈ s, h1Class (ℓ c) := by
  classical
  induction mem_closure_range_h1Class h using AddSubgroup.closure_induction with
  | mem k hk =>
    obtain ⟨y, γ, rfl⟩ := hk
    refine ⟨{ZerothHomotopy.mk y}, fun c => if hc : Joined (componentRep c) y then
      (hc.somePath.trans γ).trans hc.somePath.symm else Path.refl _, ?_⟩
    rw [Finset.sum_singleton]
    dsimp only
    rw [dite_eq_left (joined_componentRep_mk y), h1Class_conj]
  | zero => exact ⟨∅, fun c => Path.refl _, by simp⟩
  | add k k' _ _ hk hk' =>
    obtain ⟨s, ℓ₁, rfl⟩ := hk
    obtain ⟨s', ℓ₂, rfl⟩ := hk'
    refine ⟨s ∪ s', fun c => (if c ∈ s then ℓ₁ c else Path.refl _).trans
      (if c ∈ s' then ℓ₂ c else Path.refl _), ?_⟩
    simp only [h1Class_trans, Finset.sum_add_distrib, apply_ite h1Class, h1Class_refl]
    rw [Finset.sum_ite_mem, Finset.sum_ite_mem, Finset.union_inter_cancel_left,
      Finset.union_inter_cancel_right]
  | neg k _ hk =>
    obtain ⟨s, ℓ₁, rfl⟩ := hk
    exact ⟨s, fun c => (ℓ₁ c).symm, by simp [h1Class_symm]⟩

end Peano
